# Pak Commerce Environment Variables
# Local Development defaults

NODE_ENV=development
PORT=4000

# Database (PostgreSQL - Local or Neon.tech)
DATABASE_URL="postgresql://pakcommerce_user:pakcommerce_password@localhost:5432/pakcommerce_db?schema=public"

# Redis (Local or Upstash)
REDIS_URL="redis://localhost:6379"

# Security & JWT
JWT_SECRET="pakcommerce_super_secret_jwt_key_2026_change_in_production"
JWT_EXPIRES_IN="7d"

# Storefront & Admin URLs
APP_DOMAIN="pakcommerce.pk"
ADMIN_URL="http://admin.localhost:3000"
STOREFRONT_URL="http://localhost:3001"

# SMS / OTP Provider (Twilio / Jazz / Telenor / WhatsApp Cloud API)
OTP_EXPIRY_MINUTES=5
SIMULATE_OTP=true # Set true for local testing without real SMS cost