datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

// ----------------------------------------------------
// 1. Multi-Tenant Core Architecture
// ----------------------------------------------------

enum TenantStatus {
  TRIAL
  ACTIVE
  SUSPENDED
}

model Tenant {
  id            String       @id @default(uuid())
  name          String
  subdomain     String       @unique // e.g. "khaadi", "gulahmed"
  customDomain  String?      @unique // e.g. "khaadistore.com"
  currency      String       @default("PKR")
  status        TenantStatus @default(TRIAL)
  logoUrl       String?
  bannerUrl     String?
  phoneSupport  String?      // WhatsApp or Support helpline
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  users         User[]
  products      Product[]
  orders        Order[]
  shippingRules ShippingRule[]
  customers     Customer[]
  discounts     Discount[]
  webhooks      Webhook[]
  locations     Location[]
  collections   Collection[]
  payments      Payment[]
  integrationSettings IntegrationSetting[]

  @@map("tenants")
}

enum UserRole {
  MERCHANT_ADMIN
  STORE_MANAGER
  STAFF
}

model User {
  id           String    @id @default(uuid())
  tenantId     String
  tenant       Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name         String
  email        String
  phone        String?
  passwordHash String
  role         UserRole  @default(MERCHANT_ADMIN)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([tenantId, email])
  @@map("users")
}

// ----------------------------------------------------
// 2. Product Catalog & Variants
// ----------------------------------------------------

model Product {
  id             String           @id @default(uuid())
  tenantId       String
  tenant         Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title          String
  titleUrdu      String?          // Nastaliq / Urdu Title
  description    String?
  descriptionUr  String?
  category       String           @default("General")
  tags           String[]         @default([])
  isActive       Boolean          @default(true)
  isHalal        Boolean          @default(true) // Sharia Halal compliance flag
  images         String[]         @default([])
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  variants       ProductVariant[]
  collections    CollectionProduct[]

  @@index([tenantId, category])
  @@map("products")
}

model ProductVariant {
  id              String      @id @default(uuid())
  productId       String
  product         Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  title           String      // e.g. "Large / Blue" or "Unstitched 3-Piece"
  sku             String?
  price           Float       // Price in PKR (TODO Phase 1: money as Decimal)
  compareAtPrice  Float?      // Discount strike-through
  stockQuantity   Int         @default(0)
  weightGrams     Int         @default(500)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  orderItems      OrderItem[]

  @@map("product_variants")
}

// ----------------------------------------------------
// 3. Customers (CRM) — Shopify parity
// ----------------------------------------------------

model Customer {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name        String
  phone       String   // normalized: 03XXXXXXXXX
  email       String?
  tags        String[] @default([])
  notes       String?
  ordersCount Int      @default(0)
  totalSpent  Float    @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  addresses CustomerAddress[]
  orders    Order[]

  @@unique([tenantId, phone])
  @@index([tenantId, email])
  @@map("customers")
}

model CustomerAddress {
  id         String   @id @default(uuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  city       String
  address    String
  isDefault  Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("customer_addresses")
}

// ----------------------------------------------------
// 4. Discounts Engine — Shopify parity
// ----------------------------------------------------

enum DiscountType {
  PERCENTAGE
  FIXED
  FREE_SHIPPING
}

model Discount {
  id          String       @id @default(uuid())
  tenantId    String
  tenant      Tenant       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  code        String       // e.g. "SAVE10" (uppercase, unique per tenant)
  description String?
  type        DiscountType
  value       Float        @default(0) // % (0-100) for PERCENTAGE, PKR for FIXED
  minSubtotal Float?       // minimum cart subtotal to qualify (nullable = no minimum)
  maxUses     Int?         // null = unlimited
  usedCount   Int          @default(0)
  firstOnly   Boolean      @default(false) // first-order-only
  startsAt    DateTime?
  endsAt      DateTime?
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  orders Order[]

  @@unique([tenantId, code])
  @@index([tenantId, isActive])
  @@map("discounts")
}

// ----------------------------------------------------
// 5. Orders & Cash-on-Delivery (COD) Risk Engine
// ----------------------------------------------------

enum OrderStatus {
  PENDING
  VERIFIED
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
  RTO
}

enum PaymentMethod {
  COD
  IBFT
  RAAST
  JAZZCASH
  EASYPAISA
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum RiskScore {
  LOW
  MEDIUM
  HIGH
}

model Order {
  id               String            @id @default(uuid())
  tenantId         String
  tenant           Tenant            @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderNumber      String            // e.g. "PK-1001"
  // Linked CRM customer (optional — guest orders allowed)
  customerId       String?
  customer         Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  customerName     String
  customerPhone    String            // 03XX-XXXXXXX
  customerEmail    String?
  shippingCity     String            // Standardized Pakistani City
  shippingAddress  String
  shippingFee      Float             @default(200.00) // Shipping fee in PKR
  subtotal         Float             // Order subtotal (SERVER-computed)
  discountAmount   Float             @default(0)     // applied discount value
  discountId       String?
  discount         Discount?         @relation(fields: [discountId], references: [id], onDelete: SetNull)
  totalAmount      Float             // Total including shipping, minus discount
  paymentMethod    PaymentMethod     @default(COD)
  paymentStatus    PaymentStatus     @default(PENDING)
  orderStatus      OrderStatus       @default(PENDING)
  riskScore        RiskScore         @default(LOW)
  notes            String?
  fbrInvoiceNo     String?           // FBR POS sandbox invoice number
  fbrInvoiceAt     DateTime?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  items           OrderItem[]
  fulfillments    Fulfillment[]
  refunds         Refund[]
  codVerification CodVerification?
  bankProof       BankTransferProof?
  payments        Payment[]

  @@unique([tenantId, orderNumber])
  @@index([tenantId, customerPhone])
  @@index([tenantId, customerId])
  @@map("orders")
}

model OrderItem {
  id         String         @id @default(uuid())
  orderId    String
  order      Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variantId  String
  variant    ProductVariant @relation(fields: [variantId], references: [id])
  title      String
  quantity   Int
  price      Float          // Price in PKR (SERVER-computed)

  @@map("order_items")
}

// ----------------------------------------------------
// 6. Fulfillment & Returns — Shopify parity
// ----------------------------------------------------

enum FulfillmentStatus {
  PENDING
  PARTIAL
  FULFILLED
  RESTOCKED
}

model Fulfillment {
  id             String            @id @default(uuid())
  orderId        String
  order          Order             @relation(fields: [orderId], references: [id], onDelete: Cascade)
  status         FulfillmentStatus @default(PENDING)
  trackingNumber String?
  carrier        String?           // generic carrier; Pak couriers plug in Phase 4
  shippedAt      DateTime?
  deliveredAt    DateTime?
  createdAt      DateTime          @default(now())

  items FulfillmentItem[]

  @@index([orderId])
  @@map("fulfillments")
}

model FulfillmentItem {
  id            String      @id @default(uuid())
  fulfillmentId String
  fulfillment   Fulfillment @relation(fields: [fulfillmentId], references: [id], onDelete: Cascade)
  orderItemId   String      // reference to the original OrderItem
  quantity      Int

  @@map("fulfillment_items")
}

model Refund {
  id          String   @id @default(uuid())
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  amount      Float    // refund amount in PKR
  reason      String?
  restock     Boolean  @default(true)
  processedBy String?  // staff user id
  createdAt   DateTime @default(now())

  @@index([orderId])
  @@map("refunds")
}

// ----------------------------------------------------
// 7. COD Verification & Bank Transfer Proof
// ----------------------------------------------------

model CodVerification {
  id         String    @id @default(uuid())
  orderId    String    @unique
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  otpCode    String
  isVerified Boolean   @default(false)
  verifiedAt DateTime?
  attempts   Int       @default(0)
  expiresAt  DateTime? // OTP validity window (mock SMS flow)
  createdAt  DateTime  @default(now())

  @@map("cod_verifications")
}

model BankTransferProof {
  id              String    @id @default(uuid())
  orderId         String    @unique
  order           Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  bankName        String    // e.g. "Meezan Bank", "HBL", "Nayapay"
  transactionRef  String
  receiptImageUrl String
  isApproved      Boolean   @default(false)
  approvedAt      DateTime?
  createdAt       DateTime  @default(now())

  @@map("bank_transfer_proofs")
}

// ----------------------------------------------------
// 8. Shipping Rules (Pakistani Cities & Rates)
// ----------------------------------------------------

model ShippingRule {
  id          String   @id @default(uuid())
  tenantId    String
  tenant      Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  city        String   // e.g. "Karachi", "Lahore", "All Pakistan"
  rate        Float    // Shipping rate in PKR
  isFreeAbove Float?   // Free delivery threshold amount
  createdAt   DateTime @default(now())

  @@map("shipping_rules")
}

// ----------------------------------------------------
// 9. Webhooks Event Engine — Shopify parity
// ----------------------------------------------------

enum WebhookStatus {
  ACTIVE
  PAUSED
}

model Webhook {
  id        String        @id @default(uuid())
  tenantId  String
  tenant    Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  url       String        // target endpoint (HTTPS recommended)
  events    String[]      // e.g. ["order.created", "order.fulfilled"]
  secret    String        // used for HMAC-SHA256 payload signing
  status    WebhookStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  deliveries WebhookDelivery[]

  @@index([tenantId, status])
  @@map("webhooks")
}

// ----------------------------------------------------
// 9b. Collections (Shopify parity) — smart/manual grouping
// ----------------------------------------------------

model Collection {
  id       String  @id @default(uuid())
  tenantId String
  tenant   Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  title    String
  handle   String  // URL slug, unique per tenant
  rules    String? // reserved for smart collection rule JSON
  isActive Boolean @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  products CollectionProduct[]

  @@unique([tenantId, handle])
  @@index([tenantId, isActive])
  @@map("collections")
}

model CollectionProduct {
  id           String    @id @default(uuid())
  collectionId String
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  position     Int       @default(0)
  createdAt    DateTime  @default(now())

  @@unique([collectionId, productId])
  @@map("collection_products")
}

model WebhookDelivery {
  id           String    @id @default(uuid())
  webhookId    String
  webhook      Webhook   @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  event        String    // e.g. "order.created"
  payload      String    // JSON-serialized payload
  responseCode Int?
  attempts     Int       @default(0)
  success      Boolean   @default(false)
  lastAttempt  DateTime?
  status       String    @default("PENDING") // PENDING | DELIVERED | FAILED
  nextRetryAt  DateTime? // set while retrying with backoff
  error        String?   // last transport/HTTP error

  @@index([webhookId, success])
  @@index([status, nextRetryAt])
  @@map("webhook_deliveries")
}

// ----------------------------------------------------
// 10. Locations (multi-location inventory scaffold)
// ----------------------------------------------------

model Location {
  id        String  @id @default(uuid())
  tenantId  String
  tenant    Tenant  @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  name      String  // e.g. "Karachi Warehouse", "Lahore Gulberg Store"
  address   String?
  isDefault Boolean @default(false)
  createdAt DateTime @default(now())

  @@map("locations")
}

// ----------------------------------------------------
// 11. Payments — gateway transaction ledger
// ----------------------------------------------------

enum PaymentTxStatus {
  INITIATED      // wallet flow started, hosted checkout pending
  AWAITING_PROOF // manual methods (IBFT / RAAST) — customer must submit proof
  SUCCEEDED      // gateway confirmed or merchant approved proof
  FAILED
}

model Payment {
  id           String          @id @default(uuid())
  tenantId     String
  tenant       Tenant          @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  orderId      String
  order        Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  method       PaymentMethod   // wallet or manual method (COD never creates a Payment)
  status       PaymentTxStatus @default(INITIATED)
  amount       Float           // PKR, mirrors order.totalAmount at initiation
  gatewayTxRef String          @unique // our reference sent to the gateway
  providerRef  String?         // gateway auth code / bank transaction id
  redirectUrl  String?         // hosted checkout URL (wallet gateways)
  instructions String?         // free-text payment instructions (IBFT / RAAST)
  markedPaidAt DateTime?
  errorMessage String?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt

  @@index([orderId])
  @@index([tenantId, status])
  @@map("payments")
}

// ----------------------------------------------------
// 12. Integrations — per-tenant credentials for external services
// (Phase 4: gateways, couriers, SMS providers, FBR; secrets write-only)
// ----------------------------------------------------

model IntegrationSetting {
  id         String   @id @default(uuid())
  tenantId   String
  tenant     Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  provider   String   // JAZZCASH | EASYPAISA | TCS | LEOPARDS | POSTEX | TRAX | TWILIO | FBR | IBFT | RAAST
  configJson String   // JSON credentials blob (masked in API responses)
  sandbox    Boolean  @default(true)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([tenantId, provider])
  @@map("integration_settings")
}
