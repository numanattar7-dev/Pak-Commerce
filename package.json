{
  "name": "pak-commerce",
  "version": "0.1.0",
  "private": true,
  "description": "Hyper-Localized Merchant Operating System & Composable Commerce Platform for Pakistan",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push"
  },
  "devDependencies": {
    "@types/multer": "^2.3.0",
    "autoprefixer": "^10.6.2",
    "prettier": "^3.2.5",
    "turbo": "^2.0.0",
    "typescript": "^5.4.5"
  },
  "packageManager": "npm@10.2.4",
  "dependencies": {
    "@neon/config": "^1.9.6",
    "@neon/env": "^1.6.6"
  }
}
